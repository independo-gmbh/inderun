{
  "name": "@independo/inderun-contracts",
  "version": "0.4.0",
  "description": "Canonical contracts for IndeRun (on-device AI that uses a cloud only if you allow it): JSON Schemas, generated TypeScript types and validators for task, streaming, error and routing.",
  "license": "MIT",
  "author": {
    "name": "Independo GmbH",
    "url": "https://www.independo.app"
  },
  "homepage": "https://inderun.dev/docs",
  "bugs": "https://github.com/independo-gmbh/inderun/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/independo-gmbh/inderun.git",
    "directory": "packages/contracts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "inderun",
    "ai",
    "llm",
    "contracts",
    "json-schema",
    "validation",
    "types",
    "streaming"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "verify:packaging": "publint && attw --pack . --profile esm-only",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "vitest": "^5.0.5"
  }
}

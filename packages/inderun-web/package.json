{
  "name": "@independo/inderun-web",
  "version": "0.2.2",
  "description": "TypeScript/Web SDK for IndeRun.",
  "license": "MIT",
  "author": {
    "name": "Independo GmbH",
    "url": "https://www.independo.app"
  },
  "homepage": "https://github.com/independo-gmbh/inderun#readme",
  "bugs": "https://github.com/independo-gmbh/inderun/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/independo-gmbh/inderun.git",
    "directory": "packages/inderun-web"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "inderun",
    "ai",
    "sdk",
    "web",
    "llm",
    "routing"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "default": "./dist/openai.js"
    },
    "./onnx": {
      "types": "./dist/onnx.d.ts",
      "default": "./dist/onnx.js"
    },
    "./system-model": {
      "types": "./dist/system-model.d.ts",
      "default": "./dist/system-model.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@independo/inderun-contracts": "workspace:^",
    "@independo/inderun-route-core-wasm": "workspace:^"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}

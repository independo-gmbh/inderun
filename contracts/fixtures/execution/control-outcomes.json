{
  "$comment": "ADR 025 section 4: the engine validates and completes the control records a provider reports, before the output leaves the engine. 'reported' is what the provider put in output.speech.controls, or null when its output has no speech section at all; 'expected' is either the records the caller receives, in request order, or a failure with errorClass Internal and details.code 'output_mismatch' (the provider broke the contract after commit, so there is no fallback). A required control on a completed run must be applied, so an output without a speech section fails only when a control is required; for preferred-only controls it passes unchanged ('expected' then lists no controls: no section, no records); on a cancelled run, missing records become not_applied / not_reported. Scenario catalog: each SDK registers one handler per case id (Stage 2 of #311).",
  "cases": [
    {
      "id": "complete_records",
      "description": "One record per requested control, required applied, preferred pitch not applied with a reason.",
      "request": {
        "schemaVersion": "1.1",
        "task": {
          "kind": "text_to_speech"
        },
        "speech": {
          "text": "Guten Morgen!",
          "locale": "de-AT",
          "controls": {
            "speakingRate": {
              "value": 0.85,
              "requirement": "required"
            },
            "pitch": {
              "value": 1.05
            }
          }
        },
        "delivery": {
          "mode": "playback",
          "playback": {
            "volume": {
              "value": 0.7
            }
          }
        }
      },
      "reported": [
        {
          "id": "speech.speakingRate",
          "requested": 0.85,
          "status": "applied",
          "effective": 0.85,
          "method": "platform_synthesis"
        },
        {
          "id": "speech.pitch",
          "requested": 1.05,
          "status": "not_applied",
          "reason": "unsupported"
        },
        {
          "id": "playback.volume",
          "requested": 0.7,
          "status": "applied",
          "effective": 0.7,
          "method": "playback_attenuation"
        }
      ],
      "expected": {
        "failed": false,
        "controls": [
          {
            "id": "speech.speakingRate",
            "requested": 0.85,
            "status": "applied",
            "effective": 0.85,
            "method": "platform_synthesis"
          },
          {
            "id": "speech.pitch",
            "requested": 1.05,
            "status": "not_applied",
            "reason": "unsupported"
          },
          {
            "id": "playback.volume",
            "requested": 0.7,
            "status": "applied",
            "effective": 0.7,
            "method": "playback_attenuation"
          }
        ]
      }
    },

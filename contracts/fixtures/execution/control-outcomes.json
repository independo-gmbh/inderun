    {
      "id": "cancelled_keeps_known_records",
      "description": "A cancelled playback keeps what was reported before the stop; the cancelled ending is not a failure, and unreported controls become not_reported.",
      "request": {
        "schemaVersion": "1.1",
        "task": {
          "kind": "text_to_speech"
        },
        "speech": {
          "text": "Guten Morgen!",
          "locale": "de-AT",
          "controls": {
            "speakingRate": {
              "value": 0.85,

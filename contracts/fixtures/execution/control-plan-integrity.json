{
  "$comment": "ADR 025 section 3: a control application plan that does not match the request prevents execution. The planner boundary is unversioned, and a route core or binding built without the plan would otherwise turn a required control into 'no controls'. Each case gives the request and the 'controls' of the planned candidate (null means the key is absent); 'fallbackCandidateControls', when present, is a second candidate's. The engine checks every candidate after planning and before any attempt: each requested control exactly once, in request order, with the requested id, value and requirement, every required one with decision 'apply'; an 'omit' entry with a reason and an 'apply' entry without one; no entry for a control the request did not name. A mismatch fails the run with errorClass Internal and details.code 'control_plan_mismatch' and no attempt. Scenario catalog: each SDK registers one handler per case id (Stage 2 of #311).",
  "cases": [
    {
      "id": "consistent_plan",
      "description": "Every requested control has exactly one entry, in request order, with the requested value; every required one is 'apply'. The run proceeds.",
      "request": {
        "schemaVersion": "1.1",
        "task": {
          "kind": "text_to_speech"
        },
        "speech": {
          "text": "Guten Morgen!",
          "locale": "de-AT",
          "controls": {
            "speakingRate": {
              "value": 0.85,
              "requirement": "required"
            },
            "pitch": {
              "value": 1.05
            }
          }
        },
        "delivery": {
          "mode": "playback"
        }
      },
      "candidateControls": [
        {
          "id": "speech.speakingRate",
          "value": 0.85,
          "requirement": "required",
          "decision": "apply"
        },
        {
          "id": "speech.pitch",
          "value": 1.05,
          "requirement": "preferred",
          "decision": "omit",
          "reason": "unsupported"
        }
      ],
      "expected": {
        "refused": false
      }
    },
    {
      "id": "no_controls_no_plan",
      "description": "A request without controls and a candidate without a plan: unchanged behaviour.",
      "request": {
        "schemaVersion": "1.1",
        "task": {
          "kind": "text_to_speech"
        },
        "speech": {
          "text": "Guten Morgen!",
          "locale": "de-AT"
        },
        "delivery": {
          "mode": "playback"
        }
      },
      "candidateControls": null,
      "expected": {
        "refused": false
      }
    },
    {
      "id": "required_plan_missing",
      "description": "The candidate carries no plan although the request requires a rate, e.g. from a route core built before ADR 025. A missing plan is never read as 'no controls'.",
      "request": {
        "schemaVersion": "1.1",
        "task": {
          "kind": "text_to_speech"
        },
        "speech": {
          "text": "Guten Morgen!",
          "locale": "de-AT",
          "controls": {
            "speakingRate": {
              "value": 0.85,
              "requirement": "required"
            }
          }
        },
        "delivery": {
          "mode": "playback"
        }
      },
      "candidateControls": null,
      "expected": {
        "refused": true,
        "errorClass": "Internal",
        "detailsCode": "control_plan_mismatch",
        "attemptCount": 0
      }
    },
    {
      "id": "required_plan_empty",

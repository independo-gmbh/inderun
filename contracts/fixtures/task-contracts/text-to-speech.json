        "delivery": {
          "mode": "artifact",
          "mediaTypes": [
            "audio/wav",
            "audio/mpeg"
          ]
        },
        "locale": {
          "tag": "en-GB",
          "match": "exact"
        }
      }
    },
    {
      "id": "playback_controls_run",

            "byteLength": 94508,
            "durationMs": 2140
          },
          "speech": {
            "locale": "en-GB"
          }
        },
        "finishReason": "stop",
        "telemetry": {
          "providerUsed": "openai_compatible_cloud:tts",
          "totalMs": 980
        }
      },
      "planner": {
        "kind": "text_to_speech",
        "inputs": [
          "text"

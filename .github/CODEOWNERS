# Default: no owner, so ordinary changes keep the current review flow.

# Everything that decides what ends up inside the committed route-core
# XCFramework, or what is allowed to ship it. That artifact is executable code
# distributed to SwiftPM consumers, and its integrity rests on the provenance
# manifest, the verification script, and the toolchain pin agreeing with each
# other -- a change to any one of them alone can quietly weaken the other two.
/ios/IndeRun/Frameworks/                       @kstruempf
/scripts/build-route-core-apple.mjs            @kstruempf
/scripts/route-core-apple-provenance.mjs       @kstruempf
/scripts/verify-route-core-apple.mjs           @kstruempf
/scripts/rust-toolchain.mjs                    @kstruempf

# The Android route core is built at publish time rather than committed, so the
# artifact is only as trustworthy as the script that produces it.
/scripts/build-route-core-android.mjs          @kstruempf
/rust-toolchain.toml                           @kstruempf

# Release configuration: what gets versioned, tagged, and published.
/release.config.js                             @kstruempf
/.github/workflows/release.yml                 @kstruempf
